# Copy to .env.local for local development. Leave empty to run in demo mode (saved in the browser only).
# Both values are public client settings from Supabase → Project Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# "/" locally; "/habit-arena/" when served from GitHub Pages at <user>.github.io/habit-arena/
VITE_BASE=/
